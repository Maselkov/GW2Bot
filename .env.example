# Copy to .env and fill in. Used by docker-compose.yml.

# Required: bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Your Discord user ID (for owner-only commands like >sync)
OWNER_ID=

# Optional: server ID used for testing commands
TEST_GUILD=

# Optional: text command prefix (default ">")
PREFIX=

# Optional: MongoDB database name and credentials (the bundled mongo
# container runs without auth)
MONGO_DB=
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_DB=

DEBUG=false
