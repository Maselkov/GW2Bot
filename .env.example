# Copy to .env and fill in. Used by docker-compose.yml.

# Required: bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Your Discord user ID (for owner-only commands like >sync)
OWNER_ID=

# Optional: server ID used for testing commands
TEST_GUILD=

# Optional: text command prefix (default ">")
PREFIX=

# Optional: full MongoDB connection string. Overrides the MONGO_* settings
# below (MONGO_HOST/MONGO_PORT are set by docker-compose.yml)
MONGO_URI=

# Optional: MongoDB database name and credentials (the bundled mongo
# container runs without auth)
MONGO_DB=
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_DB=

# Sync slash commands on startup when they changed. Set to false for a local
# copy that uses the production token
AUTO_SYNC=true

DEBUG=false
